{
  "$schema": "https://pi.dev/schemas/keybindings.schema.json",
  "tui.altScreen.searchNext": "ctrl+g",
  "tui.altScreen.searchPrevious": "ctrl+shift+g",
  "tui.select.up": ["up", "ctrl+p"],
  "tui.select.down": ["down", "ctrl+n"],
  "app.message.followUp": "ctrl+q",
  "app.message.dequeue": "shift+up",
  "app.thinking.toggle": "ctrl+t",
  "app.session.togglePath": "ctrl+o",
  "app.session.toggleNamedFilter": "ctrl+x",
  "app.models.toggleProvider": "ctrl+o",
  "app.models.reorderUp": "shift+up",
  "app.models.reorderDown": "shift+down"
}
