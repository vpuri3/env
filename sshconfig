# Shared SSH hosts, included from the bottom of each machine's ~/.ssh/config.
# Machine-specific and work hosts go in ~/.ssh/config above the env block,
# never here: this repo is public.
#
# ssh uses the first value it finds for each option, so per-host settings must
# come before the `Host *` defaults at the end of this file.
#
# ForwardAgent lets the remote host use your local keys while you are
# connected (e.g. to push to GitHub). It is enabled only for hosts where you
# log in as yourself, not for shared or other people's accounts.

# CHMU Orchard
Host orchard
    HostName orchard-login-001
    User vedantpu
    ForwardAgent yes
    IdentityFile ~/.ssh/google_compute_engine
    ProxyCommand ~/Downloads/google-cloud-sdk/bin/gcloud compute start-iap-tunnel %h 22 --listen-on-stdin --zone "us-central1-c" --project "cmu-gpu-cloud"

# VDEL
Host eagle
    HostName vdel-eagle.me.cmu.edu
    User vedantpu
    ForwardAgent yes

# Defaults for every host. Keep this block last.
Host *
    AddKeysToAgent yes
    IgnoreUnknown UseKeychain
    UseKeychain yes
    ForwardAgent no
    ForwardX11 yes
