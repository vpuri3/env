#!/bin/bash
# Replaces each symlink with a regular copy of what it points to, in place.
set -eu

for file in "$@"; do
    if [ ! -L "$file" ]; then
        echo "delink: $file is not a symlink, skipping" >&2
        continue
    fi
    tmp="$file.delink.$$"
    cp -RL "$file" "$tmp"
    rm "$file"
    mv "$tmp" "$file"
    echo "delinked $file"
done
